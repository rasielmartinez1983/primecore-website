# Copy this to .env.local for local dev (gitignored). In production
# (Vercel), set these as real Environment Variables in the project
# dashboard instead.

# Power the /projects page (see lib/projectsData.ts) -- server-to-server
# calls to primecore-ops-local (list of Invoiced/Paid projects) and
# primecore-field-photos (each project's "Project Photos" wrap-up shots).
# These are read server-side only (Server Component), never sent to the
# browser -- do NOT prefix them with NEXT_PUBLIC_. Not required for local
# dev unless you're testing that page -- it just fails soft to an empty
# gallery if any of these are unset.
#
# OPS_LOCAL_URL is ops.primecore's live URL (no trailing slash).
# FIELD_PHOTOS_URL is field-photos' live URL (no trailing slash).
# OPS_INTERNAL_API_KEY must be the exact same value as ops-local's own
# OPS_INTERNAL_API_KEY env var (the shared secret it already uses to talk
# to field-photos/ExcelApp/the Primecore homepage -- see those apps'
# /api/internal/* routes).
OPS_LOCAL_URL=
FIELD_PHOTOS_URL=
OPS_INTERNAL_API_KEY=

# Powers the /admin section (hide/unhide photos on /projects, edit each
# project's website summary) -- this site's own Postgres database, only
# used to store which photo ids an admin has hidden (see prisma/schema.prisma
# and lib/hiddenPhotos.ts). Same Neon-style Postgres setup as every other
# PrimeCore app.
DATABASE_URL=

# A single shared admin password (no per-user accounts) -- set this to
# something only you know, then log in at /admin/login.
WEBSITE_ADMIN_PASSWORD=

# Random secret used to sign the /admin login cookie -- generate with
# `openssl rand -hex 32`. Must be set in production; without it every admin
# session becomes forgeable (see lib/adminSession.ts).
WEBSITE_ADMIN_SESSION_SECRET=
